# RAGLens AI - environment variables
# Copy this file to ".env" and fill in your own keys. Never commit .env.

# REQUIRED - used for embeddings (text-embedding-3-large), the generator
# (gpt-4o-mini) and the DeepEval judge models (gpt-4o-mini).
OPENAI_API_KEY=sk-your-openai-key-here

# OPTIONAL - LangSmith tracing. Used by the @traceable decorators in
# src/rag_pipeline.py and src/reranker.py, and by evals/eval_online.py
# (online evaluation of live traces). Leave blank if you don't use LangSmith.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=raglens-ai
